+ ******************************************************************************
+ *
+ * The original ("master") Xenia XMA decoder, ported from xenia-canary's
+ * xma_context_master.cc. Selected with xma_decoder = "master".
+ *
+ * It decodes whole frames straight into the output ring buffer and, unlike the
+ * newer decoder, invalidates the output buffer as soon as a context runs out of
+ * input. Some games (Naruto: The Broken Bond) wait for exactly that before they
+ * consider a voice finished; with the newer decoder their cutscenes never
+ * advance past the first spoken line.
+ */
+
+#include <chrono>
+#include <cstring>
+#include <tuple>
+
+#include <rex/audio/xma/context.h>
+#include <rex/audio/xma/helpers.h>
+#include <rex/cvar.h>
+#include <rex/logging.h>
+#include <rex/memory/ring_buffer.h>
+#include <rex/stream.h>
+
+extern "C" {
+#include "libavcodec/avcodec.h"
+#include "libavutil/error.h"
+}  // extern "C"
+
+REXCVAR_DECLARE(std::string, xma_decoder);
+REXCVAR_DECLARE(bool, xma_trace);
+
+namespace rex::audio {
+
+using stream::BitStream;
+
+namespace {
+
+constexpr uint32_t kBytesPerPacket = XmaContext::kBytesPerPacket;
+constexpr uint32_t kBitsPerPacket = XmaContext::kBitsPerPacket;
+
+void MasterSwapInputBuffer(XMA_CONTEXT_DATA* data) {
+  if (data->current_buffer == 0) {
+    data->input_buffer_0_valid = 0;
+  } else {
+    data->input_buffer_1_valid = 0;
+  }
+  data->current_buffer ^= 1;
+  data->input_buffer_read_offset = 0;
+}
+
+// buffer_bits: size of the current input buffer. A streamed sound can loop over a region that
+// spans many buffers (loop_end lies beyond this one); then the buffer must be consumed instead of
+// replayed, or the stream never advances (fight loading screens hang on their music).
+bool TrySetupNextLoop(XMA_CONTEXT_DATA* data, bool ignore_input_buffer_offset, size_t buffer_bits) {
+  if (data->loop_end > buffer_bits) {
+    return false;
+  }
+  if (data->loop_count > 0 && data->loop_start < data->loop_end &&
+      (ignore_input_buffer_offset || data->input_buffer_read_offset >= data->loop_end)) {
+    data->input_buffer_read_offset = data->loop_start;
+    if (data->loop_count < 255) {
+      data->loop_count--;
+    }
+    return true;
+  }
+  return false;
+}
+
+int GetFramePacketNumber(uint8_t* block, size_t size, size_t bit_offset) {
+  size *= 8;
+  if (bit_offset >= size) {
+    return -1;
+  }
+  return static_cast<int>((bit_offset >> 3) / kBytesPerPacket);
+}
+
+bool ValidFrameOffset(uint8_t* block, size_t size_bytes, size_t frame_offset_bits) {
+  const int packet_num = GetFramePacketNumber(block, size_bytes, frame_offset_bits);
+  if (packet_num == -1) {
+    return false;
+  }
+  uint8_t* packet = block + (packet_num * kBytesPerPacket);
+  const size_t relative_offset_bits = frame_offset_bits % kBitsPerPacket;
+
+  const uint32_t first_frame_offset = xma::GetPacketFrameOffset(packet);
+  if (first_frame_offset == static_cast<uint32_t>(-1) || first_frame_offset > kBitsPerPacket) {
+    return false;
+  }
+
+  BitStream stream(packet, kBitsPerPacket);
+  stream.SetOffset(first_frame_offset);
+  while (true) {
+    if (stream.offset_bits() == relative_offset_bits) {
+      return true;
+    }
+    if (stream.BitsRemaining() < 15) {
+      return false;
+    }
+    const uint64_t size = stream.Read(15);
+    if ((size - 15) > stream.BitsRemaining()) {
+      return false;
+    } else if (size == 0x7FFF) {
+      return false;
+    }
+    stream.Advance(size - 16);
+    if (stream.Read(1) == 0) {
+      break;
+    }
+  }
+  return false;
+}
+
+size_t GetNextFrame(uint8_t* block, size_t size, size_t bit_offset) {
+  const int packet_idx = GetFramePacketNumber(block, size, bit_offset);
+
+  BitStream stream(block, size * 8);
+  stream.SetOffset(bit_offset);
+  if (stream.BitsRemaining() < 15) {
+    return 0;
+  }
+  const uint64_t len = stream.Read(15);
+  if ((len - 15) > stream.BitsRemaining()) {
+    return 0;
+  } else if (len >= xma::kMaxFrameLength) {
+    return 0;
+  }
+  stream.Advance(len - (15 + 1));
+  if (stream.Read(1) == 0) {
+    return 0;
+  }
+  bit_offset += len;
+  if (packet_idx < GetFramePacketNumber(block, size, bit_offset)) {
+    return 0;
+  }
+  return bit_offset;
+}
+
+std::tuple<int, int> GetFrameNumber(uint8_t* block, size_t size, size_t bit_offset) {
+  const int packet_idx = GetFramePacketNumber(block, size, bit_offset);
+  if (packet_idx < 0 || (packet_idx + 1) * kBytesPerPacket > size) {
+    return {packet_idx, -2};
+  }
+  if (bit_offset == 0) {
+    return {packet_idx, -1};
+  }
+
+  uint8_t* packet = block + (packet_idx * kBytesPerPacket);
+  const auto first_frame_offset = xma::GetPacketFrameOffset(packet);
+  BitStream stream(block, size * 8);
+  stream.SetOffset(packet_idx * kBitsPerPacket + first_frame_offset);
+
+  int frame_idx = 0;
+  while (true) {
+    if (stream.BitsRemaining() < 15) {
+      break;
+    }
+    if (stream.offset_bits() == bit_offset) {
+      break;
+    }
+    const uint64_t frame_size = stream.Read(15);
+    if ((frame_size - 15) > stream.BitsRemaining()) {
+      break;
+    } else if (frame_size == 0x7FFF) {
+      break;
+    }
+    stream.Advance(frame_size - (15 + 1));
+    if (stream.Read(1) == 0) {
+      break;
+    }
+    frame_idx++;
+  }
+  return {packet_idx, frame_idx};
+}
+
+std::tuple<int, bool> GetPacketFrameCount(uint8_t* packet) {
+  const auto first_frame_offset = xma::GetPacketFrameOffset(packet);
+  if (first_frame_offset > kBitsPerPacket - 33) {
+    return {0, false};
+  }
+
+  BitStream stream(packet, kBitsPerPacket);
+  stream.SetOffset(first_frame_offset);
+  int frame_count = 0;
+  while (true) {
+    frame_count++;
+    if (stream.BitsRemaining() < 15) {
+      return {frame_count, true};
+    }
+    const uint64_t size = stream.Read(15);
+    if ((size - 15) > stream.BitsRemaining()) {
+      return {frame_count, true};
+    } else if (size == 0x7FFF) {
+      return {frame_count, true};
+    }
+    stream.Advance(size - (15 + 1));
+    if (stream.Read(1) == 0) {
+      return {frame_count, false};
+    }
+  }
+}
+
+}  // namespace
+
+bool XmaContext::UseMasterDecoder() {
+  return REXCVAR_GET(xma_decoder) == "master";
+}
+
+bool XmaContext::WorkMaster() {
+  std::lock_guard<std::mutex> lock(lock_);
+  if (!is_allocated() || !is_enabled()) {
+    return false;
+  }
+  set_is_enabled(false);
+
+  auto context_ptr = memory()->TranslateVirtual(guest_ptr());
+  XMA_CONTEXT_DATA data(context_ptr);
+  if (REXCVAR_GET(xma_trace)) {
+    const auto now = std::chrono::steady_clock::now();
+    if (now - last_trace_time_ >= std::chrono::seconds(2)) {
+      last_trace_time_ = now;
+      REXAPU_INFO(
+          "xma_trace: master ctx {} in0={}({}) in1={}({}) cur={} read={} out_valid={} out r/w={}/{} "
+          "of {} loop={} [{}..{}] skip={} split={}/{}",
+          id(), uint32_t(data.input_buffer_0_valid), uint32_t(data.input_buffer_0_packet_count),
+          uint32_t(data.input_buffer_1_valid), uint32_t(data.input_buffer_1_packet_count),
+          uint32_t(data.current_buffer), uint32_t(data.input_buffer_read_offset),
+          uint32_t(data.output_buffer_valid), uint32_t(data.output_buffer_read_offset),
+          uint32_t(data.output_buffer_write_offset), uint32_t(data.output_buffer_block_count),
+          uint32_t(data.loop_count), uint32_t(data.loop_start), uint32_t(data.loop_end),
+          master_packets_skip_, master_split_frame_len_, master_split_frame_len_partial_);
+    }
+  }
+  DecodeMaster(&data);
+  data.Store(context_ptr);
+  return true;
+}
+
+void XmaContext::ClearMaster() {
+  std::lock_guard<std::mutex> lock(lock_);
+  auto context_ptr = memory()->TranslateVirtual(guest_ptr());
+  XMA_CONTEXT_DATA data(context_ptr);
+
+  data.input_buffer_0_valid = 0;
+  data.input_buffer_1_valid = 0;
+  data.output_buffer_valid = 0;
+  data.output_buffer_read_offset = 0;
+  data.output_buffer_write_offset = 0;
+  master_packets_skip_ = 0;
+  master_split_frame_len_ = 0;
+  master_split_frame_len_partial_ = 0;
+  master_split_frame_padding_start_ = 0;
+
+  data.Store(context_ptr);
+}
+
+void XmaContext::DecodeMaster(XMA_CONTEXT_DATA* data) {
+  if (!data->output_buffer_valid) {
+    return;
+  }
+
+  // No available data.
+  if (!data->input_buffer_0_valid && !data->input_buffer_1_valid) {
+    data->output_buffer_valid = 0;
+    return;
+  }
+
+  // Games may use rolling input buffers that are not contiguous.
+  uint8_t* in0 = data->input_buffer_0_valid ? memory()->TranslatePhysical(data->input_buffer_0_ptr)
+                                            : nullptr;
+  uint8_t* in1 = data->input_buffer_1_valid ? memory()->TranslatePhysical(data->input_buffer_1_ptr)
+                                            : nullptr;
+  uint8_t* current_input_buffer = data->current_buffer ? in1 : in0;
+  if (!current_input_buffer) {
+    // The current buffer was consumed; continue in the other one.
+    MasterSwapInputBuffer(data);
+    return;
+  }
+
+  const size_t input_buffer_0_size = data->input_buffer_0_packet_count * kBytesPerPacket;
+  const size_t input_buffer_1_size = data->input_buffer_1_packet_count * kBytesPerPacket;
+  const size_t current_input_size = data->current_buffer ? input_buffer_1_size : input_buffer_0_size;
+  const size_t current_input_packet_count = current_input_size / kBytesPerPacket;
+
+  // Output buffers hold raw PCM, 256 bytes per block, as a ring buffer.
+  uint8_t* output_buffer = memory()->TranslatePhysical(data->output_buffer_ptr);
+  const uint32_t output_capacity = data->output_buffer_block_count * kBytesPerSubframeChannel;
+  const uint32_t output_read_offset = data->output_buffer_read_offset * kBytesPerSubframeChannel;
+  const uint32_t output_write_offset = data->output_buffer_write_offset * kBytesPerSubframeChannel;
+
+  memory::RingBuffer output_rb(output_buffer, output_capacity);
+  output_rb.set_read_offset(output_read_offset);
+  output_rb.set_write_offset(output_write_offset);
+
+  // Only whole frames are written.
+  size_t output_remaining_bytes = output_rb.write_count();
+  output_remaining_bytes -= output_remaining_bytes % (kBytesPerFrameChannel << data->is_stereo);
+
+  bool reuse_input_buffer = false;
+  while (output_remaining_bytes > 0) {
+    if (!data->input_buffer_0_valid && !data->input_buffer_1_valid) {
+      break;
+    }
+
+    // The input buffer must not be swapped out until all loops are processed.
+    reuse_input_buffer = TrySetupNextLoop(data, false, current_input_size * 8);
+
+    int packet_idx, frame_idx, frame_count;
+    uint8_t* packet;
+    bool frame_last_split;
+
+    BitStream stream(current_input_buffer, current_input_size * 8);
+    stream.SetOffset(data->input_buffer_read_offset);
+
+    // After a buffer swap, skip packets first.
+    if (master_packets_skip_ > 0) {
+      packet_idx = GetFramePacketNumber(current_input_buffer, current_input_size,
+                                        data->input_buffer_read_offset);
+      while (master_packets_skip_ > 0) {
+        master_packets_skip_--;
+        packet_idx++;
+        if (packet_idx >= static_cast<int>(current_input_packet_count)) {
+          if (!reuse_input_buffer) {
+            reuse_input_buffer = TrySetupNextLoop(data, true, current_input_size * 8);
+          }
+          if (!reuse_input_buffer) {
+            MasterSwapInputBuffer(data);
+          }
+          return;
+        }
+      }
+      data->input_buffer_read_offset = packet_idx * kBitsPerPacket;
+    }
+
+    if (master_split_frame_len_) {
+      // Finish a frame that was split over two packets.
+      packet_idx = GetFramePacketNumber(current_input_buffer, current_input_size,
+                                        data->input_buffer_read_offset);
+      if (packet_idx < 0) {
+        MasterSwapInputBuffer(data);
+        return;
+      }
+      packet = current_input_buffer + packet_idx * kBytesPerPacket;
+      std::tie(frame_count, frame_last_split) = GetPacketFrameCount(packet);
+      frame_idx = -1;
+
+      stream = BitStream(current_input_buffer, (packet_idx + 1) * kBitsPerPacket);
+      stream.SetOffset(packet_idx * kBitsPerPacket + 32);
+
+      if (master_split_frame_len_ > xma::kMaxFrameLength) {
+        const auto offset = stream.offset_bits();
+        stream.Copy(xma_frame_.data() + 1 +
+                        ((master_split_frame_len_partial_ + master_split_frame_padding_start_) / 8),
+                    15 - master_split_frame_len_partial_);
+        stream.SetOffset(offset);
+        BitStream slen(xma_frame_.data() + 1, 15 + master_split_frame_padding_start_);
+        slen.Advance(master_split_frame_padding_start_);
+        master_split_frame_len_ = static_cast<uint32_t>(slen.Read(15));
+      }
+
+      stream.Copy(xma_frame_.data() + 1 +
+                      ((master_split_frame_len_partial_ + master_split_frame_padding_start_) / 8),
+                  master_split_frame_len_ - master_split_frame_len_partial_);
+    } else {
+      if (data->input_buffer_read_offset % kBitsPerPacket == 0) {
+        // Not a frame offset yet: move to the first frame of the packet.
+        const int packet_number = GetFramePacketNumber(current_input_buffer, current_input_size,
+                                                       data->input_buffer_read_offset);
+        if (packet_number == -1) {
+          return;
+        }
+        const uint32_t first = xma::GetPacketFrameOffset(current_input_buffer +
+                                                         kBytesPerPacket * packet_number);
+        if (first == static_cast<uint32_t>(-1)) {
+          MasterSwapInputBuffer(data);
+          return;
+        }
+        data->input_buffer_read_offset = first + data->input_buffer_read_offset;
+      }
+
+      if (!ValidFrameOffset(current_input_buffer, current_input_size,
+                            data->input_buffer_read_offset)) {
+        MasterSwapInputBuffer(data);
+        return;
+      }
+
+      std::tie(packet_idx, frame_idx) =
+          GetFrameNumber(current_input_buffer, current_input_size, data->input_buffer_read_offset);
+      if (packet_idx < 0 || frame_idx < 0) {
+        MasterSwapInputBuffer(data);
+        return;
+      }
+      packet = current_input_buffer + packet_idx * kBytesPerPacket;
+      std::tie(frame_count, frame_last_split) = GetPacketFrameCount(packet);
+
+      PrepareDecoder(data->sample_rate, bool(data->is_stereo));
+
+      const bool frame_is_split = frame_last_split && (frame_idx >= frame_count - 1);
+
+      stream = BitStream(current_input_buffer, (packet_idx + 1) * kBitsPerPacket);
+      stream.SetOffset(data->input_buffer_read_offset);
+      master_split_frame_len_partial_ = static_cast<uint32_t>(stream.BitsRemaining());
+      if (master_split_frame_len_partial_ >= 15) {
+        master_split_frame_len_ = static_cast<uint32_t>(stream.Peek(15));
+      } else {
+        master_split_frame_len_ = xma::kMaxFrameLength + 1;
+      }
+
+      std::memset(xma_frame_.data(), 0, xma_frame_.size());
+      {
+        const auto offset = stream.Copy(
+            xma_frame_.data() + 1, std::min(master_split_frame_len_, master_split_frame_len_partial_));
+        master_split_frame_padding_start_ = static_cast<uint8_t>(offset);
+      }
+
+      if (frame_is_split) {
+        // Continue in the next packet of this stream.
+        master_packets_skip_ = xma::GetPacketSkipCount(packet) + 1;
+        while (master_packets_skip_ > 0) {
+          master_packets_skip_--;
+          packet += kBytesPerPacket;
+          packet_idx++;
+          if (packet_idx >= static_cast<int>(current_input_packet_count)) {
+            if (!reuse_input_buffer) {
+              reuse_input_buffer = TrySetupNextLoop(data, true, current_input_size * 8);
+            }
+            if (!reuse_input_buffer) {
+              MasterSwapInputBuffer(data);
+            }
+            return;
+          }
+        }
+        data->input_buffer_read_offset = packet_idx * kBitsPerPacket;
+        continue;
+      }
+    }
+
+    // Also needed for frames finished after a split: a released context has its codec settings
+    // cleared, and decoding without reopening it fails every frame.
+    if (PrepareDecoder(data->sample_rate, bool(data->is_stereo)) < 0) {
+      return;
+    }
+    PreparePacket(master_split_frame_len_, master_split_frame_padding_start_);
+    master_split_frame_len_ = 0;
+    master_split_frame_len_partial_ = 0;
+    master_split_frame_padding_start_ = 0;
+
+    auto ret = avcodec_send_packet(av_context_, av_packet_);
+    if (ret < 0) {
+      REXAPU_ERROR("XmaContext {}: Error sending packet for decoding", id());
+    }
+    ret = avcodec_receive_frame(av_context_, av_frame_);
+    if (ret == AVERROR(EAGAIN)) {
+      return;
+    }
+    if (ret < 0) {
+      char errbuf[AV_ERROR_MAX_STRING_SIZE];
+      av_strerror(ret, errbuf, sizeof(errbuf));
+      REXAPU_ERROR("XmaContext {}: Error during decoding: {} ({})", id(), errbuf, ret);
+      return;
+    }
+
+    ConvertFrame(reinterpret_cast<const uint8_t**>(&av_frame_->data), bool(data->is_stereo),
+                 raw_frame_.data());
+
+    const auto byte_count = kBytesPerFrameChannel << data->is_stereo;
+    output_rb.Write(raw_frame_.data(), byte_count);
+    output_remaining_bytes -= byte_count;
+    data->output_buffer_write_offset = output_rb.write_offset() / 256;
+
+    uint32_t offset = data->input_buffer_read_offset;
+    offset = static_cast<uint32_t>(GetNextFrame(current_input_buffer, current_input_size, offset));
+    if (frame_idx + 1 >= frame_count) {
+      // Skip to the next packet (no split frame).
+      master_packets_skip_ = xma::GetPacketSkipCount(packet) + 1;
+      while (master_packets_skip_ > 0) {
+        master_packets_skip_--;
+        packet_idx++;
+        if (packet_idx >= static_cast<int>(current_input_packet_count)) {
+          if (!reuse_input_buffer) {
+            reuse_input_buffer = TrySetupNextLoop(data, true, current_input_size * 8);
+          }
+          if (!reuse_input_buffer) {
+            MasterSwapInputBuffer(data);
+          }
+          return;
+        }
+      }
+      packet = current_input_buffer + packet_idx * kBytesPerPacket;
+      offset = xma::GetPacketFrameOffset(packet) + packet_idx * kBitsPerPacket;
+    }
+    if (offset == 0 || frame_idx == -1) {
+      if (packet_idx >= static_cast<int>(current_input_packet_count)) {
+        if (!reuse_input_buffer) {
+          reuse_input_buffer = TrySetupNextLoop(data, true, current_input_size * 8);
+        }
+        if (!reuse_input_buffer) {
+          MasterSwapInputBuffer(data);
+        }
+        break;
+      }
+      offset = xma::GetPacketFrameOffset(packet) + packet_idx * kBitsPerPacket;
+    }
+    data->input_buffer_read_offset = offset;
+  }
+
+  // The game kicks the context again with a new output buffer later. Only
+  // invalidate it when nothing is left to read.
+  if (output_rb.write_offset() == output_rb.read_offset()) {
+    data->output_buffer_valid = 0;
+  }
+}
+
+}  // namespace rex::audio
