+void XmaContext::DecodePendingSplitFrame(XMA_CONTEXT_DATA* data, uint8_t* current_input_buffer,
+                                         uint32_t current_input_packet_count) {
+  split_frame_pending_ = false;
+  // The frame's packet data, then the data of this buffer's first packet, which
+  // begins with the frame's continuation.
+  std::memcpy(input_buffer_.data(), split_frame_packet_.data(), kBytesPerPacketData);
+  std::memcpy(input_buffer_.data() + kBytesPerPacketData, current_input_buffer + kBytesPerPacketHeader,
+              kBytesPerPacketData);
+  DecodeFrame(data, split_frame_offset_, split_frame_size_, false);
+
+  // Continue at the first frame that starts in this buffer.
+  uint32_t next_input_offset = xma::GetPacketFrameOffset(current_input_buffer);
+  if (next_input_offset > kMaxFrameSizeinBits) {
+    // No frame starts in the first packet: it only holds the rest of this one.
+    next_input_offset = GetNextPacketReadOffset(current_input_buffer, 1, current_input_packet_count);
+    if (next_input_offset == kBitsPerPacketHeader) {
+      SwapInputBuffer(data);
+      return;
+    }
+  }
+  data->input_buffer_read_offset = next_input_offset;
+}
+
+bool XmaContext::FlushCarry(XMA_CONTEXT_DATA* data) {
+  if (!carry_valid_ || current_frame_remaining_subframes_ > 0) {
+    return false;
+  }
+  // As DecodeFrame assembles a block: the carried part of the frame, then the
+  // head of the next decode, which is not coming (silence).
+  const size_t pad_bytes = kDecoderStartPadding * kBytesPerSample << data->is_stereo;
+  const size_t carry_bytes = (kBytesPerFrameChannel << data->is_stereo) - pad_bytes;
+  std::memcpy(raw_frame_.data(), carry_frame_.data(), carry_bytes);
+  std::memset(raw_frame_.data() + carry_bytes, 0, pad_bytes);
+
+  current_frame_remaining_subframes_ = 4 << data->is_stereo;
+  loop_frame_output_limit_ = pending_output_limit_;
+  current_frame_remaining_subframes_ -=
+      std::min(pending_start_skip_, current_frame_remaining_subframes_);
+
+  carry_valid_ = false;
+  pending_output_limit_ = 0;
+  pending_start_skip_ = 0;
+  return true;
+}
