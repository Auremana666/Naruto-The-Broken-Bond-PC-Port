+void XmaContext::DecodePendingSplitFrame(XMA_CONTEXT_DATA* data, uint8_t* current_input_buffer,
+                                         uint32_t current_input_packet_count) {
+  split_frame_pending_ = false;
+  // The frame's packet data, then the data of this buffer's first packet, which
+  // begins with the frame's continuation.
+  std::memcpy(input_buffer_.data(), split_frame_packet_.data(), kBytesPerPacketData);
+  std::memcpy(input_buffer_.data() + kBytesPerPacketData, current_input_buffer + kBytesPerPacketHeader,
+              kBytesPerPacketData);
+  if (split_frame_size_ == 0) {
+    // The header was split too: read it across the two packets.
+    BitStream combined(input_buffer_.data(), (kBitsPerPacket - kBitsPerPacketHeader) * 2);
+    combined.SetOffset(split_frame_offset_);
+    split_frame_size_ = static_cast<uint32_t>(combined.Peek(kBitsPerFrameHeader));
+  }
+  if (split_frame_size_ != 0 && split_frame_size_ != xma::kMaxFrameLength) {
+    DecodeFrame(data, split_frame_offset_, split_frame_size_, false);
+  }
+
+  // Continue at the first frame that starts in this buffer.
+  uint32_t next_input_offset = xma::GetPacketFrameOffset(current_input_buffer);
+  if (next_input_offset > kMaxFrameSizeinBits) {
+    // No frame starts in the first packet: it only holds the rest of this one.
+    next_input_offset = GetNextPacketReadOffset(current_input_buffer, 1, current_input_packet_count);
+    if (next_input_offset == kBitsPerPacketHeader) {
+      SwapInputBuffer(data);
+      return;
+    }
+  }
+  data->input_buffer_read_offset = next_input_offset;
+}
+
+void XmaContext::DecodeFrame(XMA_CONTEXT_DATA* data, uint32_t data_offset, uint32_t frame_size,
+                             bool is_loop_end_frame) {
+  BitStream stream(input_buffer_.data(), (kBitsPerPacket - kBitsPerPacketHeader) * 2);
+  stream.SetOffset(data_offset);
+
+  xma_frame_.fill(0);
+
+  const uint32_t padding_start =
+      static_cast<uint8_t>(stream.Copy(xma_frame_.data() + 1, frame_size));
+
+  raw_frame_.fill(0);
+
+  // The decoded block is queued as it comes, as the hardware is assumed to: a
+  // title that counts the samples of an input buffer before it submits the
+  // next one (Broken Bond's streamed voices and music, one buffer valid at a
+  // time) gets every frame of the buffer once it is decoded. Realigning the
+  // block onto the bitstream's sample numbering held each frame back until the
+  // next decode, so at a buffer boundary the title waited for a frame that
+  // needed the next buffer, and queuing it early with silence for its last
+  // kDecoderStartPadding samples put a gap into the stream at every boundary.
+  PrepareDecoder(data->sample_rate, bool(data->is_stereo));
+  PreparePacket(frame_size, padding_start);
+  if (DecodePacket(av_context_, av_packet_, av_frame_)) {
+    ConvertFrame(reinterpret_cast<const uint8_t**>(&av_frame_->data), bool(data->is_stereo),
+                 raw_frame_.data());
+    current_frame_remaining_subframes_ = 4 << data->is_stereo;
+
+    // Loop end: limit output to subframes 0..loop_subframe_end.
+    loop_frame_output_limit_ =
+        is_loop_end_frame ? static_cast<uint8_t>((data->loop_subframe_end + 1) << data->is_stereo)
+                          : 0;
+
+    // Loop start: skip leading subframes per loop_subframe_skip. skip == 4
+    // means the whole frame is a warm-up frame (frame-aligned loop start):
+    // decode seeds the codec state, output is fully discarded.
+    if (loop_start_skip_pending_) {
+      const uint8_t skip = static_cast<uint8_t>(data->loop_subframe_skip << data->is_stereo);
+      current_frame_remaining_subframes_ -= std::min(skip, current_frame_remaining_subframes_);
+      loop_start_skip_pending_ = false;
+    }
+  }
+}
+
 void XmaContext::ConvertFrame(const uint8_t** samples, bool is_two_channel,
                               uint8_t* output_buffer) {
   // Loop through every sample, convert and drop it into the output array.
