@@ -25,6 +25,12 @@
 void SetMouseLookActive(bool active);
 bool IsMouseLookActive();
 
+// Direct mouse look: while on, mouse motion no longer moves the right stick;
+// the title takes the motion (pixels since the last take) and turns its camera
+// by it. The mouse is still captured as for mnk_mouse.
+void SetDirectMouseLook(bool on);
+bool TakeMouseLook(float* dx, float* dy);
+
 class MnkInputDriver final : public InputDriver,
                              public rex::ui::WindowInputListener,
                              public rex::ui::WindowListener {
diff --git a/src/input/mnk/mnk_input_driver.cpp b/src/input/mnk/mnk_input_driver.cpp
--- a/src/input/mnk/mnk_input_driver.cpp
+++ b/src/input/mnk/mnk_input_driver.cpp
@@ -187,9 +187,26 @@
 }
 
 std::atomic<bool> mouse_look_active{true};
+std::atomic<bool> direct_mouse_look{false};
+std::mutex direct_mutex;
+float direct_dx = 0.0f, direct_dy = 0.0f;
 
 }  // namespace
 
+void SetDirectMouseLook(bool on) {
+  if (direct_mouse_look.exchange(on, std::memory_order_relaxed) == on) return;
+  std::lock_guard lock(direct_mutex);
+  direct_dx = direct_dy = 0.0f;
+}
+
+bool TakeMouseLook(float* dx, float* dy) {
+  std::lock_guard lock(direct_mutex);
+  *dx = direct_dx;
+  *dy = direct_dy;
+  direct_dx = direct_dy = 0.0f;
+  return *dx != 0.0f || *dy != 0.0f;
+}
+
 void SetMouseLookActive(bool active) {
   mouse_look_active.store(active, std::memory_order_relaxed);
 }
