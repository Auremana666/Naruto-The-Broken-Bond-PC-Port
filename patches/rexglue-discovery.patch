+bool isCodePointer(const BinaryView& binary, uint32_t address) {
+  return (address & 3) == 0 && binary.isExecutable(address) &&
+         !binary.isInImportExportRange(address);
+}
+
+// Code already owned by a function, so a pointer into it cannot start another.
+class ClaimedCode {
+ public:
+  explicit ClaimedCode(CodegenContext& ctx) : ctx_(ctx) {
+    std::vector<CodeRegion> claimed;
+    // Exception scope tables also contain runs of code pointers. Inline
+    // handlers may not be reachable during initial discovery, but their
+    // declared owner still reserves the entire PDATA/config extent.
+    for (const auto& [addr, size] : ctx.scan.pdataSizes)
+      claimed.push_back({addr, addr + size});
+    for (const auto& [addr, config] : ctx.Config().functions) {
+      if (uint32_t size = config.getSize(addr); size != 0)
+        claimed.push_back({addr, addr + size});
+    }
+    for (const auto& [addr, node] : ctx.graph.functions()) {
+      if (node->blocks().empty()) {
+        claimed.push_back({addr, addr + node->size()});
+      } else {
+        for (const auto& block : node->blocks())
+          claimed.push_back({block.base, block.base + block.size});
+      }
+    }
+    // A function can own out-of-line blocks beyond later function entries.
+    // Index all claimed blocks, not just the nearest preceding function.
+    std::sort(claimed.begin(), claimed.end(),
+              [](const auto& a, const auto& b) { return a.start < b.start; });
+    for (const auto& block : claimed) {
+      if (!coverage_.empty() && block.start <= coverage_.back().end)
+        coverage_.back().end = std::max(coverage_.back().end, block.end);
+      else
+        coverage_.push_back(block);
+    }
+  }
+
+  // True if a referenced address can start a new function without splitting
+  // existing code: it is unowned and begins a region or follows an
+  // unconditional branch.
+  bool isUnclaimedEntry(uint32_t address) const {
+    auto& decoded = ctx_.decoded();
+    if (ctx_.graph.isEntryPoint(address))
+      return false;
+    auto covered = std::upper_bound(coverage_.begin(), coverage_.end(), address,
+                                    [](uint32_t addr, const auto& block) {
+                                      return addr < block.start;
+                                    });
+    if (covered != coverage_.begin() && std::prev(covered)->contains(address))
+      return false;
+    const auto* region = decoded.regionContaining(address);
+    const auto* insn = decoded.get(address);
+    if (!region || !insn || insn->opcode == Opcode::kUnknown)
+      return false;
+    if (address == region->start)
+      return true;
+
+    // A pointer into a block, a call continuation, or a conditional-branch
+    // fallthrough is not evidence of another function. Do not split those.
+    const auto* previous = decoded.get(address - 4);
+    return previous && previous->is_branch() && !previous->is_call() &&
+           !previous->is_conditional();
+  }
+
+ private:
+  CodegenContext& ctx_;
+  std::vector<CodeRegion> coverage_;
+};
