+uint32_t Branch(uint32_t from, uint32_t to) {
+  return 0x48000000 | ((to - from) & 0x03FFFFFC);
+}
+
+class PointerTableModule : public TestModule {
+ public:
+  void AddTable(const std::vector<uint8_t>& data, bool executable) {
+    binary_sections_.push_back({".rdata", kData, static_cast<uint32_t>(data.size()),
+                                data.data(), executable, false});
+  }
