+size_t discoverFunctionPointerTables(CodegenContext& ctx) {
+  auto& graph = ctx.graph;
+  const auto& binary = ctx.binary();
+  const auto* rdata = binary.findSectionByName(".rdata");
+  if (!rdata || !rdata->data || rdata->executable)
+    return 0;
+
+  // RTTI is optional. Require a run of code pointers anchored by two distinct
+  // already-discovered functions before considering its remaining entries.
+  // Snapshot the anchors so speculative discoveries cannot validate later runs.
+  std::unordered_set<uint32_t> anchors;
+  for (const auto& [addr, node] : graph.functions()) {
+    if (!node->isImport() && !node->canDiscover())
+      anchors.insert(addr);
+  }
+  const ClaimedCode claimed(ctx);
+
+  size_t found = 0;
+  for (size_t offset = 0; offset + 4 <= rdata->size;) {
+    std::vector<uint32_t> slots;
+    std::unordered_set<uint32_t> known;
+    const size_t runStart = offset;
+    while (offset + 4 <= rdata->size) {
+      uint32_t target = load_and_swap<uint32_t>(rdata->data + offset);
+      if (!isCodePointer(binary, target))
+        break;
+      slots.push_back(target);
+      if (anchors.contains(target))
+        known.insert(target);
+      offset += 4;
+    }
+    if (slots.size() >= 3 && known.size() >= 2) {
+      for (uint32_t target : slots) {
+        if (!claimed.isUnclaimedEntry(target))
+          continue;
+        graph.addFunction(target, 4, FunctionAuthority::VTABLE, true);
+        ++found;
+        REXCODEGEN_DEBUG("Analyze: function 0x{:08X} referenced by pointer table 0x{:08X}",
+                         target, rdata->baseAddress + static_cast<uint32_t>(runStart));
+      }
+    }
+    // Skip the non-pointer terminating this run (including an empty run).
+    offset += 4;
+  }
+  return found;
+}
+
+// Forget every register an instruction may write. Forgetting too much only
+// misses a reference; keeping a stale high half would invent one.
+void forgetWrittenRegisters(const DecodedInsn& insn, std::bitset<32>& known) {
+  if (insn.is_branch()) {
+    if (insn.is_call()) {
+      known.reset(0);
+      for (uint32_t reg = 3; reg <= 12; ++reg)
+        known.reset(reg);
+    } else if (!insn.is_conditional()) {
+      known.reset();
+    }
+    return;
+  }
+  const auto& info = ppc::get_opcode_info(insn.opcode);
+  if (info.group == ppc::OpcodeGroup::kMemory) {
+    const std::string_view name = info.name ? info.name : "";
+    if (!name.starts_with("st"))
+      known.reset(insn.D.RT);
+    if (name.ends_with('u') || name.ends_with("ux"))
+      known.reset(insn.D.RA);
+    return;
+  }
+  // addi writes RT and ori writes RA; keep their shared source register.
+  if (insn.opcode != Opcode::ori)
+    known.reset(insn.D.RT);
+  if (insn.opcode != Opcode::addi)
+    known.reset(insn.D.RA);
+}
+
+// Address-taken functions without a direct call, such as qsort comparators,
+// callbacks, and member-pointer thunks, are referenced only by a lis+addi or
+// lis+ori pair. Call-graph discovery misses them, and an indirect call to one
+// traps at runtime.
+size_t discoverCodeAddressReferences(CodegenContext& ctx) {
+  auto& graph = ctx.graph;
+  auto& decoded = ctx.decoded();
+  const auto& binary = ctx.binary();
+  const ClaimedCode claimed(ctx);
+
+  // Switch dispatch also materializes the address of its table, which follows
+  // a bctr just like a function entry would.
+  std::unordered_set<uint32_t> tables;
+  for (const auto& [addr, table] : ctx.Config().switchTables)
+    tables.insert(table.tableAddress);
+
+  // Only discovered code is scanned, so data in executable sections cannot
+  // form a reference. Register state starts empty at every block and label.
+  std::vector<std::pair<uint32_t, uint32_t>> references;
+  for (const auto& [addr, node] : graph.functions()) {
+    if (node->isImport() || node->canDiscover())
+      continue;
+    for (const auto& table : node->jumpTables())
+      tables.insert(table.tableAddress);
+    for (const auto& block : node->blocks()) {
+      std::array<uint32_t, 32> high{};
+      std::bitset<32> known;
+      for (uint32_t site = block.base; site < block.end(); site += 4) {
+        if (node->isLabel(site))
+          known.reset();
+        const auto* insn = decoded.get(site);
+        if (!insn) {
+          known.reset();
+          continue;
+        }
+        if (isLis(*insn)) {
+          high[insn->D.RT] = static_cast<uint32_t>(insn->D.d) << 16;
+          known.set(insn->D.RT);
+          continue;
+        }
+        if (insn->opcode == Opcode::addi && insn->D.RA != 0 && known.test(insn->D.RA))
+          references.push_back({site, high[insn->D.RA] + static_cast<uint32_t>(insn->D.SIMM())});
+        else if (insn->opcode == Opcode::ori && known.test(insn->D.RT))
+          references.push_back({site, high[insn->D.RT] | insn->D.UIMM()});
+        forgetWrittenRegisters(*insn, known);
+      }
+    }
+  }
+
+  size_t found = 0;
+  for (const auto& [site, target] : references) {
+    if (!isCodePointer(binary, target) || tables.contains(target))
+      continue;
+    // A switch table the scanner did not recognize starts with a code
+    // address, not with an instruction.
+    auto first = decoded.read<uint32_t>(target);
+    if (!first || isCodePointer(binary, *first))
+      continue;
+    if (!claimed.isUnclaimedEntry(target))
+      continue;
+    graph.addFunction(target, 4, FunctionAuthority::DISCOVERED, true);
+    ++found;
+    REXCODEGEN_DEBUG("Analyze: function 0x{:08X} referenced by address at 0x{:08X}", target,
+                     site);
+  }
+  return found;
+}
