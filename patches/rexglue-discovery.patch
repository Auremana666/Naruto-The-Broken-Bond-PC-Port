+    for (uint32_t offset : {0x10u, 0x48u, 0x80u, 0xA0u})
+      ctx->graph.addFunction(kText + offset, 4, FunctionAuthority::DISCOVERED, true);
+    if (outOfLineBlock) {
+      auto* owner = ctx->graph.addFunction(kText + 0xB0, 4,
+                                          FunctionAuthority::DISCOVERED, true);
+      owner->discover({{kText + 0xB0, 4}, {kText + 0x104, 4}}, {}, {});
+      ctx->graph.addFunction(kText + 0xD0, 4, FunctionAuthority::DISCOVERED, true);
+    }
+    if (declaredExtent != FunctionAuthority::DISCOVERED) {
+      constexpr uint32_t owner = kText + 0xB0;
+      constexpr uint32_t extent = 0x58;
+      ctx->graph.addFunction(owner, extent, declaredExtent, true);
+      if (declaredExtent == FunctionAuthority::PDATA)
+        ctx->scan.pdataSizes[owner] = extent;
+      else
+        ctx->Config().functions[owner].size = extent;
+    }
+    ctx->initDecoded();
+    REQUIRE(phases::Scan(*ctx, nullptr));
+    REQUIRE(phases::Discover(*ctx, nullptr));
+    return ctx;
+  }
+};
+
+}  // namespace
+
+TEST_CASE("Anchored pointer tables discover RTTI-free indirect and guarded tail thunks",
+          "[codegen][pointer_table]") {
+  PointerTableFixture fixture;
+  auto ctx = fixture.Analyze({0x10, 0x1C, 0x2C, 0x48, 0x54, 0x80});
+  for (uint32_t offset : {0x1Cu, 0x2Cu, 0x54u}) {
+    auto* node = ctx->graph.getFunction(kText + offset);
+    REQUIRE(node != nullptr);
+    CHECK(node->authority() == FunctionAuthority::VTABLE);
+    CHECK_FALSE(node->canDiscover());
+  }
+  CHECK(ctx->graph.getFunction(kText + 0x1C)->size() == 16);
+  CHECK(ctx->graph.getFunction(kText + 0x2C)->size() == 16);
+  CHECK(ctx->graph.getFunction(kText + 0x54)->size() == 20);
+}
+
+TEST_CASE("Pointer tables preserve internal blocks and fallthrough addresses",
+          "[codegen][pointer_table]") {
+  PointerTableFixture fixture;
+  auto ctx = fixture.Analyze({0x10, 0x80, 0xA8, 0xC4, 0xE4, 0x104, 0x120});
+  for (uint32_t offset : {0xA8u, 0xC4u, 0xE4u, 0x104u, 0x120u})
+    CHECK_FALSE(ctx->graph.isEntryPoint(kText + offset));
+  CHECK(ctx->graph.getFunctionContaining(kText + 0xA8)->base() == kText + 0xA0);
+}
+
+TEST_CASE("Pointer table discovery requires independent anchors and data-section evidence",
+          "[codegen][pointer_table]") {
+  PointerTableFixture fixture;
+  SECTION("No known functions") {
+    auto ctx = fixture.Analyze({0x1C, 0x2C, 0x54});
+    CHECK_FALSE(ctx->graph.isEntryPoint(kText + 0x1C));
+  }
+  SECTION("Repeated references to one anchor are insufficient") {
+    auto ctx = fixture.Analyze({0x10, 0x10, 0x1C});
+    CHECK_FALSE(ctx->graph.isEntryPoint(kText + 0x1C));
+  }
+  SECTION("An unaligned pointer breaks the run") {
+    auto ctx = fixture.Analyze({0x10, 0x81, 0x1C});
+    CHECK_FALSE(ctx->graph.isEntryPoint(kText + 0x1C));
+  }
+  SECTION("A non-executable target breaks the run") {
+    auto ctx = fixture.Analyze({0x10, 0x80, kData - kText, 0x1C});
+    CHECK_FALSE(ctx->graph.isEntryPoint(kText + 0x1C));
+  }
+  SECTION("Executable bytes are not pointer-table evidence") {
+    auto ctx = fixture.Analyze({0x10, 0x80, 0x1C}, true);
+    CHECK_FALSE(ctx->graph.isEntryPoint(kText + 0x1C));
+  }
+  SECTION("Out-of-line blocks remain owned across intervening function entries") {
+    PutWord(fixture.text, 0xB0, 0x4E800020);
+    PutWord(fixture.text, 0xD0, 0x4E800020);
+    PutWord(fixture.text, 0x100, Branch(0x100, 0x80));
+    auto ctx = fixture.Analyze({0x10, 0x80, 0x104}, false, true);
+    CHECK_FALSE(ctx->graph.isEntryPoint(kText + 0x104));
+  }
+}
+
+TEST_CASE("Declared function extents protect undiscovered inline exception handlers",
+          "[codegen][pointer_table]") {
+  PointerTableFixture fixture;
+  PutWord(fixture.text, 0xB0, 0x4E800020);  // Main control flow cannot reach the handler.
+  PutWord(fixture.text, 0x100, Branch(0x100, 0x80));
+  // A counted four-pointer scope record has the same surface shape as a
+  // function table. Its last field is an inline handler, not a new function.
+  const std::vector<uint32_t> record{0x10, 0x80, 0x80, 0x104};
+  SECTION("PDATA extent") {
+    auto ctx = fixture.Analyze(record, false, false, FunctionAuthority::PDATA);
+    CHECK_FALSE(ctx->graph.isEntryPoint(kText + 0x104));
+    CHECK(ctx->graph.getFunction(kText + 0xB0)->size() == 0x58);
+  }
+  SECTION("Explicit config extent") {
+    auto ctx = fixture.Analyze(record, false, false, FunctionAuthority::CONFIG);
+    CHECK_FALSE(ctx->graph.isEntryPoint(kText + 0x104));
+    CHECK(ctx->graph.getFunction(kText + 0xB0)->size() == 0x58);
+  }
+}
