+
+struct PointerTableFixture {
+  std::vector<uint8_t> text = std::vector<uint8_t>(0x140);
+
+  PointerTableFixture() {
+    // An existing indirect thunk immediately precedes two unregistered thunks.
+    PutWord(text, 0x10, 0x81830000);  // lwz r12, 0(r3)
+    PutWord(text, 0x14, 0x7D8903A6);  // mtctr r12
+    PutWord(text, 0x18, 0x4E800420);  // bctr
+    for (uint32_t start : {0x1Cu, 0x2Cu}) {
+      PutWord(text, start, 0x81830000);       // lwz r12, 0(r3)
+      PutWord(text, start + 4, 0x818C000C);   // lwz r12, 12(r12)
+      PutWord(text, start + 8, 0x7D8903A6);   // mtctr r12
+      PutWord(text, start + 12, 0x4E800420);  // bctr
+    }
+
+    // An internal backward branch precedes a separate null-guarded tail thunk.
+    PutWord(text, 0x48, 0x38630001);          // addi r3, r3, 1
+    PutWord(text, 0x4C, 0x2C030000);          // cmpwi r3, 0
+    PutWord(text, 0x50, Branch(0x50, 0x48));  // b loop
+    PutWord(text, 0x54, 0x80640010);          // lwz r3, 16(r4)
+    PutWord(text, 0x58, 0x28030000);          // cmplwi r3, 0
+    PutWord(text, 0x5C, 0x4D820020);          // beqlr
+    PutWord(text, 0x60, 0x80840014);          // lwz r4, 20(r4)
+    PutWord(text, 0x64, Branch(0x64, 0x80));  // b known_function
+    PutWord(text, 0x80, 0x4E800020);          // blr
+
+    // A real internal block also follows an unconditional branch. Table
+    // references must not turn it into an independently callable function.
+    PutWord(text, 0xA0, 0x41820008);          // beq internal_block
+    PutWord(text, 0xA4, Branch(0xA4, 0xAC));  // b return
+    PutWord(text, 0xA8, 0x38600001);          // li r3, 1
+    PutWord(text, 0xAC, 0x4E800020);          // blr
+
+    PutWord(text, 0xC0, 0x4E800421);  // bctrl: its successor is a continuation
+    PutWord(text, 0xC4, 0x4E800020);  // blr
+    PutWord(text, 0xE0, 0x4D820020);  // beqlr: its successor is a fallthrough
+    PutWord(text, 0xE4, 0x4E800020);  // blr
+    PutWord(text, 0x100, 0x60000000); // nop: no function boundary
+    PutWord(text, 0x104, 0x4E800020); // blr
+    PutWord(text, 0x120, 0xFFFFFFFF); // not a decoded function entry
