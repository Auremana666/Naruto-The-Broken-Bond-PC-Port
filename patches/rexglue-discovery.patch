+size_t discoverFunctionPointerTables(CodegenContext& ctx) {
+  auto& graph = ctx.graph;
+  auto& decoded = ctx.decoded();
+  const auto& binary = ctx.binary();
+  const auto* rdata = binary.findSectionByName(".rdata");
+  if (!rdata || !rdata->data || rdata->executable)
+    return 0;
+
+  // RTTI is optional. Require a run of code pointers anchored by two distinct
+  // already-discovered functions before considering its remaining entries.
+  // Snapshot the anchors so speculative discoveries cannot validate later runs.
+  std::unordered_set<uint32_t> anchors;
+  std::vector<CodeRegion> claimed;
+  // Exception scope tables also contain runs of code pointers. Inline handlers
+  // may not be reachable during initial discovery, but their declared owner
+  // still reserves the entire PDATA/config extent, including those gaps.
+  for (const auto& [addr, size] : ctx.scan.pdataSizes)
+    claimed.push_back({addr, addr + size});
+  for (const auto& [addr, config] : ctx.Config().functions) {
+    if (uint32_t size = config.getSize(addr); size != 0)
+      claimed.push_back({addr, addr + size});
+  }
+  for (const auto& [addr, node] : graph.functions()) {
+    if (!node->isImport() && !node->canDiscover())
+      anchors.insert(addr);
+    if (node->blocks().empty()) {
+      claimed.push_back({addr, addr + node->size()});
+    } else {
+      for (const auto& block : node->blocks())
+        claimed.push_back({block.base, block.base + block.size});
+    }
+  }
+  // A function can own out-of-line blocks beyond later function entries.
+  // Index all claimed blocks, not just the nearest preceding function.
+  std::sort(claimed.begin(), claimed.end(),
+            [](const auto& a, const auto& b) { return a.start < b.start; });
+  std::vector<CodeRegion> coverage;
+  for (const auto& block : claimed) {
+    if (!coverage.empty() && block.start <= coverage.back().end)
+      coverage.back().end = std::max(coverage.back().end, block.end);
+    else
+      coverage.push_back(block);
+  }
+
+  auto isCodePointer = [&](uint32_t address) {
+    return (address & 3) == 0 && binary.isExecutable(address) &&
+           !binary.isInImportExportRange(address);
+  };
+  auto isUnclaimedEntry = [&](uint32_t address) {
+    if (graph.isEntryPoint(address))
+      return false;
+    auto covered = std::upper_bound(coverage.begin(), coverage.end(), address,
+                                   [](uint32_t addr, const auto& block) {
+                                     return addr < block.start;
+                                   });
+    if (covered != coverage.begin() && std::prev(covered)->contains(address))
+      return false;
+    const auto* region = decoded.regionContaining(address);
+    const auto* insn = decoded.get(address);
+    if (!region || !insn || insn->opcode == Opcode::kUnknown)
+      return false;
+    if (address == region->start)
+      return true;
+
+    // A pointer into a block, a call continuation, or a conditional-branch
+    // fallthrough is not evidence of another function. Do not split those.
+    const auto* previous = decoded.get(address - 4);
+    return previous && previous->is_branch() && !previous->is_call() &&
+           !previous->is_conditional();
+  };
+
+  size_t found = 0;
+  for (size_t offset = 0; offset + 4 <= rdata->size;) {
+    std::vector<uint32_t> slots;
+    std::unordered_set<uint32_t> known;
+    const size_t runStart = offset;
+    while (offset + 4 <= rdata->size) {
+      uint32_t target = load_and_swap<uint32_t>(rdata->data + offset);
+      if (!isCodePointer(target))
+        break;
+      slots.push_back(target);
+      if (anchors.contains(target))
+        known.insert(target);
+      offset += 4;
+    }
+    if (slots.size() >= 3 && known.size() >= 2) {
+      for (uint32_t target : slots) {
+        if (!isUnclaimedEntry(target))
+          continue;
+        graph.addFunction(target, 4, FunctionAuthority::VTABLE, true);
+        ++found;
+        REXCODEGEN_DEBUG("Analyze: function 0x{:08X} referenced by pointer table 0x{:08X}",
+                         target, rdata->baseAddress + static_cast<uint32_t>(runStart));
+      }
+    }
+    // Skip the non-pointer terminating this run (including an empty run).
+    offset += 4;
+  }
+  return found;
+}
+
