diff --git a/tests/unit/codegen/code_address_reference_test.cpp b/tests/unit/codegen/code_address_reference_test.cpp
new file mode 100644
index 0000000..a2fa1a5
--- /dev/null
+++ b/tests/unit/codegen/code_address_reference_test.cpp
@@ -0,0 +1,106 @@
+#include <catch2/catch_test_macros.hpp>
+
+#include <memory>
+#include <vector>
+
+#include <rex/codegen/codegen_context.h>
+#include <rex/codegen/phases.h>
+#include <rex/codegen/test_support.h>
+
+using namespace rex::codegen;
+
+namespace {
+
+constexpr uint32_t kText = 0x81000000;
+
+void PutWord(std::vector<uint8_t>& bytes, size_t offset, uint32_t word) {
+  for (size_t i = 0; i < 4; ++i)
+    bytes.at(offset + i) = static_cast<uint8_t>(word >> (24 - i * 8));
+}
+
+uint32_t Branch(uint32_t from, uint32_t to) {
+  return 0x48000000 | ((to - from) & 0x03FFFFFC);
+}
+
+std::unique_ptr<CodegenContext> Analyze(const std::vector<uint8_t>& text) {
+  TestModule module;
+  module.Load(kText, text.data(), text.size());
+  auto ctx = std::make_unique<CodegenContext>(
+      CodegenContext::Create(BinaryView::fromModule(module), RecompilerConfig{}));
+  ctx->graph.addFunction(kText, 4, FunctionAuthority::DISCOVERED, true);
+  ctx->initDecoded();
+  REQUIRE(phases::Scan(*ctx, nullptr));
+  REQUIRE(phases::Discover(*ctx, nullptr));
+  return ctx;
+}
+
+}  // namespace
+
+TEST_CASE("Code address references discover address-taken functions",
+          "[codegen][code_address]") {
+  std::vector<uint8_t> text(0x200);
+  // The caller is the only function reachable from the call graph.
+  PutWord(text, 0x00, 0x3D608100);  // lis r11, 0x8100
+  PutWord(text, 0x04, 0x7F83E378);  // mr r3, r28
+  PutWord(text, 0x08, 0x38CB0100);  // addi r6, r11, 0x100: comparator
+  PutWord(text, 0x0C, 0x3D408100);  // lis r10, 0x8100
+  PutWord(text, 0x10, 0x814A0000);  // lwz r10, 0(r10)
+  PutWord(text, 0x14, 0x388A0120);  // addi r4, r10, 0x120: stale high half
+  PutWord(text, 0x18, 0x3D208100);  // lis r9, 0x8100
+  PutWord(text, 0x1C, 0x61250140);  // ori r5, r9, 0x140: callback
+  PutWord(text, 0x20, 0x3D008100);  // lis r8, 0x8100
+  PutWord(text, 0x24, Branch(0x24, 0x180) | 1);  // bl callee
+  PutWord(text, 0x28, 0x38E80160);  // addi r7, r8, 0x160: clobbered by the call
+  PutWord(text, 0x2C, 0x3D808100);  // lis r12, 0x8100
+  PutWord(text, 0x30, 0x398C01A0);  // addi r12, r12, 0x1A0: pointer data
+  PutWord(text, 0x34, 0x4E800020);  // blr
+
+  // Every candidate follows an unconditional branch, so only the reference
+  // decides whether it becomes a function.
+  for (uint32_t start : {0x100u, 0x120u, 0x140u, 0x160u, 0x1A0u, 0x1C0u})
+    PutWord(text, start - 4, Branch(start - 4, 0x180));
+  PutWord(text, 0x100, 0x3D608100);  // lis r11, 0x8100
+  PutWord(text, 0x104, 0x386B01C0);  // addi r3, r11, 0x1C0: returns a function
+  PutWord(text, 0x108, 0x4E800020);  // blr
+  PutWord(text, 0x120, 0x4E800020);  // blr
+  PutWord(text, 0x140, 0x4E800020);  // blr
+  PutWord(text, 0x160, 0x4E800020);  // blr
+  PutWord(text, 0x180, 0x4E800020);  // blr
+  PutWord(text, 0x1A0, kText + 0x180);  // switch-like table of code addresses
+  PutWord(text, 0x1A4, kText + 0x100);
+  PutWord(text, 0x1C0, 0x4E800020);  // blr
+
+  auto ctx = Analyze(text);
+  for (uint32_t offset : {0x100u, 0x140u, 0x1C0u}) {
+    INFO("offset 0x" << std::hex << offset);
+    auto* node = ctx->graph.getFunction(kText + offset);
+    REQUIRE(node != nullptr);
+    CHECK(node->authority() == FunctionAuthority::DISCOVERED);
+    CHECK_FALSE(node->canDiscover());
+  }
+  for (uint32_t offset : {0x120u, 0x160u, 0x1A0u}) {
+    INFO("offset 0x" << std::hex << offset);
+    CHECK_FALSE(ctx->graph.isEntryPoint(kText + offset));
+  }
+}
+
+TEST_CASE("Code address references do not split existing code",
+          "[codegen][code_address]") {
+  std::vector<uint8_t> text(0x100);
+  PutWord(text, 0x00, 0x3D608100);  // lis r11, 0x8100
+  PutWord(text, 0x04, 0x386B0010);  // addi r3, r11, 0x10: own internal block
+  PutWord(text, 0x08, 0x41820008);  // beq 0x10
+  PutWord(text, 0x0C, Branch(0x0C, 0x14));  // b 0x14
+  PutWord(text, 0x10, 0x38600001);  // li r3, 1
+  PutWord(text, 0x14, 0x3D608100);  // lis r11, 0x8100
+  PutWord(text, 0x18, 0x2C030000);  // cmpwi r3, 0
+  PutWord(text, 0x1C, 0x386B0024);  // addi r3, r11, 0x24: conditional fallthrough
+  PutWord(text, 0x20, 0x4D820020);  // beqlr
+  PutWord(text, 0x24, 0x4E800020);  // blr
+
+  auto ctx = Analyze(text);
+  CHECK_FALSE(ctx->graph.isEntryPoint(kText + 0x10));
+  CHECK_FALSE(ctx->graph.isEntryPoint(kText + 0x24));
+  CHECK(ctx->graph.getFunctionContaining(kText + 0x10)->base() == kText);
+  CHECK(ctx->graph.getFunctionContaining(kText + 0x24)->base() == kText);
+}
