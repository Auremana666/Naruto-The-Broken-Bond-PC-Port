+
+  std::unique_ptr<CodegenContext> Analyze(std::vector<uint32_t> offsets,
+                                         bool executableTable = false,
+                                         bool outOfLineBlock = false,
+                                         FunctionAuthority declaredExtent = FunctionAuthority::DISCOVERED) {
+    // Zero guards and a trailing byte exercise bounded dword scanning.
+    std::vector<uint8_t> data((offsets.size() + 2) * 4 + (executableTable ? 0 : 1));
+    for (size_t i = 0; i < offsets.size(); ++i)
+      PutWord(data, (i + 1) * 4, kText + offsets[i]);
+    if (declaredExtent != FunctionAuthority::DISCOVERED)
+      PutWord(data, 0, 1);  // One synthetic SEH scope record follows the count.
