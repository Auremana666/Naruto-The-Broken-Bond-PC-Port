+bool IsFileLogging() {
+  std::lock_guard lock(g_mutex);
+  return g_file_sink != nullptr;
+}
+
+void SetFileLogging(bool enabled) {
+  std::lock_guard lock(g_mutex);
+  if (enabled == (g_file_sink != nullptr))
+    return;
+  if (enabled) {
+    if (g_config.app_name.empty())
+      return;  // only the automatic logs/ file can be switched on later
+    auto log_dir = g_config.log_dir.empty() ? std::filesystem::current_path() / "logs"
+                                            : std::filesystem::path(g_config.log_dir);
+    auto sink = std::make_shared<spdlog::sinks::rotating_file_sink_mt>(
+        NextSequentialLogPath(log_dir, g_config.app_name).string(),
+        static_cast<size_t>(REXCVAR_GET(log_max_file_size_mb)) * 1024 * 1024,
+        static_cast<size_t>(REXCVAR_GET(log_max_files)), false);
+    sink->set_level(spdlog::level::trace);
+    sink->set_pattern(g_config.file_pattern);
+    g_file_sink = sink;
+    for (auto& entry : g_registry) {
+      if (entry.logger)
+        entry.logger->sinks().push_back(sink);
+    }
+  } else {
+    g_file_sink->flush();
+    for (auto& entry : g_registry) {
+      if (entry.logger)
+        std::erase(entry.logger->sinks(), g_file_sink);
+    }
+    g_file_sink.reset();
+  }
+}
+
 void AddSink(spdlog::sink_ptr sink) {
   std::lock_guard lock(g_mutex);
   g_extra_sinks.push_back(sink);
