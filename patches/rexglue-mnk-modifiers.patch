+
+bool TokenPressed(const bool (&key_down)[256], std::string_view token, uint8_t live_mods) {
+  uint8_t want = TakeModifiers(token);
+  rex::ui::VirtualKey vk = rex::ui::ParseVirtualKey(token);
+  if (vk == rex::ui::VirtualKey::kNone) {
+    return false;
+  }
+  uint16_t idx = static_cast<uint16_t>(vk);
+  if (idx >= 256 || !key_down[idx]) {
+    return false;
+  }
+  // A bare modifier is a key of its own, whatever else is held.
+  if (want == 0 && ModifierBit(vk) != 0) {
+    return true;
+  }
+  return want == live_mods;
+}
+
+// The modifiers a bind value names on their own ("Shift", not "Shift+W").
+uint8_t StandaloneModifiers(const std::string& cvar_val) {
+  uint8_t mods = 0;
+  ForEachToken(cvar_val, [&](std::string_view token) {
+    if (TakeModifiers(token) == 0) {
+      mods |= ModifierBit(rex::ui::ParseVirtualKey(token));
+    }
+    return false;
+  });
+  return mods;
+}
