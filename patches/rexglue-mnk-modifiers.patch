+// The modifier a key stands for, or 0 for any other key.
+uint8_t ModifierBit(rex::ui::VirtualKey vk) {
+  switch (vk) {
+    case rex::ui::VirtualKey::kShift:
+      return kModShift;
+    case rex::ui::VirtualKey::kControl:
+      return kModCtrl;
+    case rex::ui::VirtualKey::kMenu:
+      return kModAlt;
+    default:
+      return 0;
+  }
+}
